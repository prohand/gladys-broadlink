{
  "manifest_version": 1,
  "type": "device",
  "name": "Broadlink",
  "description": {
    "en": "Local control of Broadlink devices: RM remotes (IR/RF), SP plugs, MP1 strips, A1 sensors.",
    "fr": "Broadlink en local : télécommandes RM (IR/RF), prises SP, multiprises MP1, capteurs A1."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/prohand/gladys-broadlink:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-broadlink/main/cover.jpg",
  "categories": ["multimedia", "appliances", "energy"],
  "transports": ["local"],
  "network_discovery": [
    {
      "type": "udp-active-broadcast",
      "ports": [80]
    }
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Set up your devices on your Wi-Fi with the Broadlink app first, and make sure they are NOT locked (device settings > Lock device: off). Then run a scan from the Discovery tab. Everything stays on your local network: no Broadlink account is needed here.",
        "fr": "Installez d'abord vos appareils sur votre Wi-Fi avec l'application Broadlink, et vérifiez qu'ils ne sont PAS verrouillés (paramètres de l'appareil > Verrouiller l'appareil : désactivé). Lancez ensuite un scan depuis l'onglet Découverte. Tout reste sur votre réseau local : aucun compte Broadlink n'est nécessaire ici."
      },
      "links": [
        {
          "url": "https://github.com/mjg59/python-broadlink",
          "label": {
            "en": "Supported models",
            "fr": "Modèles pris en charge"
          }
        }
      ]
    },
    {
      "key": "hosts",
      "type": "string",
      "label": {
        "en": "Device IP addresses (optional)",
        "fr": "Adresses IP des appareils (optionnel)"
      },
      "description": {
        "en": "Only if the scan does not find a device (other VLAN, broadcast filtered...): its IP addresses, separated by commas. Give your devices a fixed IP (DHCP reservation).",
        "fr": "Seulement si le scan ne trouve pas un appareil (autre VLAN, broadcast filtré…) : ses adresses IP, séparées par des virgules. Donnez une IP fixe à vos appareils (réservation DHCP)."
      },
      "placeholder": {
        "en": "192.168.1.50, 192.168.1.51",
        "fr": "192.168.1.50, 192.168.1.51"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often plug states and sensors are read, in seconds.",
        "fr": "Fréquence de lecture de l'état des prises et des capteurs, en secondes."
      },
      "required": false,
      "default": 60,
      "min": 10,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "list_devices",
      "label": {
        "en": "List found devices",
        "fr": "Lister les appareils trouvés"
      }
    },
    {
      "key": "learn_code",
      "label": {
        "en": "Learn a remote code",
        "fr": "Apprendre un code de télécommande"
      },
      "timeout_seconds": 90,
      "fields": [
        {
          "key": "learn_help",
          "type": "section",
          "label": {
            "en": "How to learn a code",
            "fr": "Comment apprendre un code"
          },
          "description": {
            "en": "Infrared: click the button, then within 30 s press the key of your original remote, pointed at the Broadlink. Radio (RF, RM pro / RM4 pro only): HOLD the key until the frequency is found (up to 30 s), release it, then press it briefly once.",
            "fr": "Infrarouge : cliquez sur le bouton, puis dans les 30 s appuyez sur la touche de votre télécommande d'origine, pointée vers le Broadlink. Radio (RF, RM pro / RM4 pro uniquement) : MAINTENEZ la touche appuyée jusqu'à ce que la fréquence soit trouvée (jusqu'à 30 s), relâchez-la, puis appuyez une fois brièvement."
          }
        },
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Code name",
            "fr": "Nom du code"
          },
          "placeholder": {
            "en": "TV on",
            "fr": "Allumer télé"
          },
          "required": true
        },
        {
          "key": "signal",
          "type": "select",
          "label": {
            "en": "Signal",
            "fr": "Signal"
          },
          "required": true,
          "default": "ir",
          "options": [
            {
              "value": "ir",
              "label": {
                "en": "Infrared (IR)",
                "fr": "Infrarouge (IR)"
              }
            },
            {
              "value": "rf",
              "label": {
                "en": "Radio (RF 433/315 MHz)",
                "fr": "Radio (RF 433/315 MHz)"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "import_code",
      "label": {
        "en": "Import a code",
        "fr": "Importer un code"
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Code name",
            "fr": "Nom du code"
          },
          "required": true
        },
        {
          "key": "code",
          "type": "string",
          "label": {
            "en": "Code (base64 or hex)",
            "fr": "Code (base64 ou hexa)"
          },
          "description": {
            "en": "A Broadlink code, e.g. copied from Home Assistant (base64, starts with \"JgB\").",
            "fr": "Un code Broadlink, par exemple copié depuis Home Assistant (base64, commence par « JgB »)."
          },
          "required": true
        }
      ]
    },
    {
      "key": "send_code",
      "label": {
        "en": "Send a code",
        "fr": "Envoyer un code"
      },
      "timeout_seconds": 15,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Code name",
            "fr": "Nom du code"
          },
          "required": true
        }
      ]
    },
    {
      "key": "list_codes",
      "label": {
        "en": "List saved codes",
        "fr": "Lister les codes enregistrés"
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        }
      ]
    },
    {
      "key": "delete_code",
      "label": {
        "en": "Delete a code",
        "fr": "Supprimer un code"
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Code name",
            "fr": "Nom du code"
          },
          "required": true
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "send_code",
      "label": {
        "en": "Send a Broadlink code",
        "fr": "Envoyer un code Broadlink"
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Remote (RM)",
            "fr": "Télécommande (RM)"
          },
          "required": true
        },
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Code name",
            "fr": "Nom du code"
          },
          "required": true
        },
        {
          "key": "repeat",
          "type": "number",
          "label": {
            "en": "Repeat",
            "fr": "Répétitions"
          },
          "required": false,
          "default": 1,
          "min": 1,
          "max": 10
        }
      ]
    }
  ]
}
